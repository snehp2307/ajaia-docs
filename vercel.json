{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build && rm -rf ../public && cp -r dist ../public",
  "rewrites": [
    {
      "source": "/doc/:id",
      "destination": "/index.html"
    },
    {
      "source": "/shared",
      "destination": "/index.html"
    }
  ]
}
